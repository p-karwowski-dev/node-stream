{
  "name": "node-stream",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc --build",
    "check:comments": "tsx tools/check-no-comments.ts",
    "check": "npm run typecheck && npm run check:comments",
    "start-server": "npm run start-server -w @node-stream/server",
    "run-match": "tsx packages/server/src/cli/main.ts run-match",
    "benchmark": "tsx packages/server/src/cli/main.ts benchmark"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
